<!doctype html>
<!-- Copy this file to the repository root as your-walk-slug.html and fill in the uppercase placeholders. -->
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#163e3a">
  <meta name="robots" content="noindex,follow">
  <link rel="canonical" href="https://searocketwhitby.co.uk/{{SLUG}}">
  <meta property="og:type" content="article">
  <meta property="og:locale" content="en_GB">
  <meta property="og:site_name" content="Sea Rocket Whitby">
  <meta property="og:title" content="{{PAGE_TITLE}}">
  <meta property="og:description" content="{{PAGE_DESCRIPTION}}">
  <meta property="og:url" content="https://searocketwhitby.co.uk/{{SLUG}}">
  <meta property="og:image" content="https://searocketwhitby.co.uk/assets/{{HERO_IMAGE}}">
  <meta property="og:image:alt" content="{{HERO_ALT}}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{PAGE_TITLE}}">
  <meta name="twitter:description" content="{{PAGE_DESCRIPTION}}">
  <meta name="twitter:image" content="https://searocketwhitby.co.uk/assets/{{HERO_IMAGE}}">
  <meta name="twitter:image:alt" content="{{HERO_ALT}}">
  <title>{{PAGE_TITLE}}</title>
  <meta name="description" content="{{PAGE_DESCRIPTION}}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="assets/walking-guide.css">
  <link rel="stylesheet" href="assets/site-chrome.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to guide</a>
  <header class="header wrap">
    <a class="brand" href="/#top" aria-label="Sea Rocket home"><img class="brand-logo" src="assets/sea-rocket-logo-white.png" alt="Sea Rocket"></a>
    <nav class="nav">
      <a href="/#house">The house</a><a href="/#explore">Explore Whitby</a><a href="/#reviews">Guest love</a>
      <a class="pill light" href="/#book">Enquire direct ↗</a>
    </nav>
  </header>
  <main id="main">
    <section class="walk-hero" aria-labelledby="walk-title">
      <img class="hero-photo" src="assets/{{HERO_IMAGE}}" alt="{{HERO_ALT}}" width="{{HERO_WIDTH}}" height="{{HERO_HEIGHT}}" fetchpriority="high">
      <div class="wrap hero-copy">
        <p class="eyebrow">The Field Guide · Whitby walks</p>
        <h1 id="walk-title">{{HEADING_FIRST_LINE}}<br><em>{{HEADING_SECOND_LINE}}</em></h1>
        <p class="hero-route">{{HERO_SUBTITLE}}</p>
        <p class="hero-description">{{HERO_DESCRIPTION}}</p>
      </div>
    </section>
    <div class="wrap">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><a href="/#field-guide">Field Guide</a><span aria-hidden="true">/</span><span aria-current="page">{{WALK_NAME}}</span>
      </nav>
      <dl class="route-facts" aria-label="Walk at a glance">
        <div><dt>Distance</dt><dd>{{DISTANCE}}<small>{{ROUTE_TYPE}}</small></dd></div>
        <div><dt>Walking time</dt><dd>{{WALKING_TIME}}<small>{{TIME_BASIS}}</small></dd></div>
        <div><dt>Difficulty</dt><dd>{{DIFFICULTY}}<small>{{TERRAIN_SUMMARY}}</small></dd></div>
        <div><dt>Start → finish</dt><dd>{{START_AND_FINISH}}<small>{{START_OR_FINISH_NOTE}}</small></dd></div>
      </dl>
    </div>
    <nav class="quick-nav" aria-label="On this page">
      <div class="wrap quick-nav-inner">
        <a href="#overview">Overview</a><a href="#should-i-walk">Should I walk?</a><a href="#route-map">Map &amp; GPX</a>
        <a href="#stages">The walk</a><a href="#good-to-know">Good to know</a><a href="#return">Getting back</a>
      </div>
    </nav>
    <div class="wrap article-shell">
      <section class="intro" id="overview" aria-labelledby="overview-title">
        <div>
          <p class="kicker">01 / The walk</p>
          <h2 id="overview-title">{{OVERVIEW_HEADING}}</h2>
          <p class="lead">{{OVERVIEW_LEAD}}</p>
          <p>{{OVERVIEW_PARAGRAPH}}</p>
          <a class="text-link" href="#route-map">Take a look at the route <span aria-hidden="true">↓</span></a>
        </div>
        <figure class="editorial-photo">
          <img src="assets/{{EDITORIAL_IMAGE}}" alt="{{EDITORIAL_ALT}}" width="{{EDITORIAL_WIDTH}}" height="{{EDITORIAL_HEIGHT}}" loading="lazy">
          <figcaption>{{EDITORIAL_CAPTION}}</figcaption>
        </figure>
      </section>

      <section class="section-space walk-fit" id="should-i-walk" aria-labelledby="walk-fit-title">
        <div class="walk-fit-intro">
          <h2 id="walk-fit-title">Should I do this walk?</h2>
          <p>Is it the right adventure for you? Answer a few quick questions and we’ll help you decide.</p>
          <p>{{WALK_SUITABILITY_SUMMARY}}</p>
        </div>
        <div class="walk-decision" data-walk-decision>
          <p class="walk-decision-progress" id="walk-decision-progress" data-walk-progress hidden></p>
          <div class="walk-decision-panels">
            <!-- Questions are numbered in their HTML order. Each data-walk-next names a data-walk-panel. -->
            <div data-walk-panel="weather" data-walk-question hidden>
              <h3 tabindex="-1" aria-describedby="walk-decision-progress">What’s the weather looking like?</h3>
              <p>Check the <a href="{{FORECAST_URL}}">forecast for {{FORECAST_LOCATION}}</a> before you answer.</p>
              <div class="walk-decision-choices">
                <button type="button" data-walk-next="fitness">Settled and reasonably clear</button>
                <button type="button" data-walk-next="postpone">{{UNSUITABLE_CONDITIONS}}</button>
              </div>
            </div>
            <div data-walk-panel="fitness" data-walk-question hidden>
              <h3 tabindex="-1" aria-describedby="walk-decision-progress">{{FITNESS_QUESTION}}</h3>
              <div class="walk-decision-choices">
                <button type="button" data-walk-next="terrain">Yes, that sounds manageable</button>
                <button type="button" data-walk-next="alternative">No, or I’m unsure</button>
              </div>
            </div>
            <div data-walk-panel="terrain" data-walk-question hidden>
              <h3 tabindex="-1" aria-describedby="walk-decision-progress">{{TERRAIN_QUESTION}}</h3>
              <div class="walk-decision-choices">
                <button type="button" data-walk-next="return-plan">Yes, with care</button>
                <button type="button" data-walk-next="alternative">I’d prefer to avoid it</button>
              </div>
            </div>
            <div data-walk-panel="return-plan" data-walk-question hidden>
              <h3 tabindex="-1" aria-describedby="walk-decision-progress">{{RETURN_QUESTION}}</h3>
              <div class="walk-decision-choices">
                <button type="button" data-walk-next="suitable">Yes, I have a plan</button>
                <button type="button" data-walk-next="plan-return">Not yet</button>
              </div>
            </div>
            <!-- Keep recommendation headings and guidance visible in the HTML for visitors without JavaScript. -->
            <div data-walk-panel="suitable">
              <h3 tabindex="-1">Sounds like a great choice.</h3>
              <p>{{SUITABLE_ADVICE}}</p>
              <a class="text-link" href="#route-map">Review the route and download the GPX</a>
            </div>
            <div data-walk-panel="postpone">
              <h3 tabindex="-1">Save it for a better day.</h3>
              <p>{{POSTPONE_ADVICE}}</p>
              <a class="text-link" href="#good-to-know">Read the advice for this walk</a>
            </div>
            <div data-walk-panel="alternative">
              <h3 tabindex="-1">Consider a gentler alternative.</h3>
              <p>{{ALTERNATIVE_ADVICE}}</p>
              <a class="text-link" href="{{ALTERNATIVE_URL}}">{{ALTERNATIVE_LINK_TEXT}}</a>
            </div>
            <div data-walk-panel="plan-return">
              <h3 tabindex="-1">Nearly there — plan your return.</h3>
              <p>{{RETURN_ADVICE}}</p>
              <a class="text-link" href="#return">See how to get back</a>
            </div>
          </div>
          <div class="walk-decision-actions" data-walk-actions hidden>
            <button type="button" data-walk-back>Back</button>
            <button type="button" data-walk-restart>Start again</button>
          </div>
        </div>
      </section>

      <section class="walk-faq" aria-labelledby="walk-faq-title">
        <h2 id="walk-faq-title">A few things worth knowing</h2>
        <!-- Duplicate, adapt or remove FAQ rows to suit the route. -->
        <details><summary>How fit do I need to be?</summary><p>{{FAQ_FITNESS}}</p></details>
        <details><summary>Can I take children?</summary><p>{{FAQ_CHILDREN}}</p></details>
        <details><summary>Is the walk suitable for dogs?</summary><p>{{FAQ_DOGS}}</p></details>
        <details><summary>What footwear should I wear?</summary><p>{{FAQ_FOOTWEAR}}</p></details>
        <details><summary>Can I walk back instead of taking transport?</summary><p>{{FAQ_WALK_BACK}}</p></details>
        <details><summary>What happens if the weather changes?</summary><p>{{FAQ_WEATHER}}</p></details>
        <details><summary>How do I get back?</summary><p>{{FAQ_RETURN}}</p></details>
      </section>

      <section class="route-section section-space" id="route-map" aria-labelledby="map-title">
        <div class="section-heading">
          <p class="kicker">02 / Find your bearings</p>
          <h2 id="map-title">The route, <em>at a glance.</em></h2>
          <p>{{MAP_INTRO}}</p>
        </div>
        <div class="route-layout">
          <div id="map-slot">
            <div class="walk-map-shell" id="walk-map-shell">
              <div class="map-toolbar">
                <button type="button" id="map-explore" hidden>Explore map</button>
                <button type="button" id="map-fit" hidden>Whole route</button>
                <button type="button" id="map-fullscreen" aria-haspopup="dialog" aria-controls="map-dialog" aria-expanded="false" hidden>Fullscreen ⛶</button>
              </div>
              <div id="walk-map" class="walk-map" role="region" aria-label="Walking route map">
                {{ROUTE_OVERVIEW_SVG}}
              </div>
              <p id="map-status" class="map-status" role="status">{{STATIC_MAP_NOTE}}</p>
              <noscript><p class="map-status">Use the route overview and GPX download to plan your walk.</p></noscript>
            </div>
          </div>
          <dialog id="map-dialog" class="map-dialog" aria-label="Walking route map"></dialog>
          <aside class="route-tools">
            <p class="kicker">Keep the walk to hand</p>
            <h3>A little preparation.<br>A better day out.</h3>
            <p>Download the track to your preferred navigation app.</p>
            <a class="pill dark" href="assets/gpx/{{SLUG}}.gpx" download="{{SLUG}}.gpx">Download GPX <span aria-hidden="true">↓</span></a>
            <p class="small route-provenance">{{GPX_NOTE}}</p>
          </aside>
        </div>
        <!-- Repeat the row in GPX waypoint order, with ids poi-1, poi-2, and so on. Remove the index if there are no waypoints. -->
        <div class="poi-index">
          <h3>Places along the way</h3>
          <ol>
            <li id="poi-1"><span class="poi-number">1</span><div><h4>{{PLACE_NAME}}</h4><p>{{PLACE_DESCRIPTION}}</p></div></li>
          </ol>
        </div>
      </section>

      <section class="section-space" id="stages" aria-labelledby="stages-title" data-stage-storage-key="{{SLUG}}">
        <div class="section-heading">
          <p class="kicker">03 / One stage at a time</p>
          <h2 id="stages-title">Make a day <em>of it.</em></h2>
          <p>Tap a stage to open its walking notes. {{STAGE_TIME_BASIS}}</p>
        </div>
        <svg class="stage-icon-library" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" width="0" height="0"><defs>
          <symbol id="icon-refreshments" viewBox="0 0 24 24"><path d="M4 8h12v8a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4Zm12 1h2a3 3 0 0 1 0 6h-2M7 3v2m5-2v2M3 22h18"/></symbol>
          <symbol id="icon-picnic" viewBox="0 0 24 24"><path d="m7 10 5-7 5 7M3 10h18l-3 11H6Zm6 4v4m6-4v4"/></symbol>
          <symbol id="icon-toilets" viewBox="0 0 24 24"><path d="M5 3h14v18H5ZM9 7v3m6-3v3M9 14h6m-3-3v7"/></symbol>
          <symbol id="icon-photo" viewBox="0 0 24 24"><path d="M3 7h5l2-3h4l2 3h5v14H3Z"/><circle cx="12" cy="13" r="4"/></symbol>
        </defs></svg>
        <h3 class="stage-card-heading" id="stage-card-title">Walking stages</h3>
        <p class="opportunity-note" id="opportunity-note">{{STAGE_OPPORTUNITIES_NOTE}}</p>
        <div id="stage-card-slot">
          <div class="stage-card" id="stage-card">
            <div class="stage-card-header">
              <button class="stage-focus-toggle" id="stage-focus-toggle" type="button" aria-haspopup="dialog" aria-controls="stage-focus-dialog" aria-expanded="false" hidden>Fullscreen <span aria-hidden="true">⛶</span></button>
            </div>
            <div class="stage-card-content">
              <ol class="stages stage-accordions">
                <!-- Duplicate this stage as needed. Update the stage id, number and link together. -->
                <li>
                  <details class="stage" id="stage-1">
                    <summary>
                      <span class="stage-number" aria-hidden="true">01</span>
                      <span class="stage-summary-copy">
                        <span class="stage-meta">{{STAGE_LABEL}}</span>
                        <span class="stage-title">{{STAGE_TITLE}}</span>
                        <span class="stage-metrics"><span>Distance <b>{{STAGE_DISTANCE}}</b></span><span>Est. time <b>{{STAGE_TIME}}</b></span></span>
                        <!-- Repeat only for verified opportunities, using one of the icon ids above. -->
                        <span class="stage-opportunities" aria-label="Along the way"><span class="opportunity"><svg aria-hidden="true"><use href="#{{OPPORTUNITY_ICON}}"/></svg>{{OPPORTUNITY_LABEL}}</span></span>
                      </span>
                      <span class="stage-chevron" aria-hidden="true"></span>
                    </summary>
                    <div class="stage-body">
                      <ol class="walking-steps"><li>{{STAGE_DIRECTION_1}}</li><li>{{STAGE_DIRECTION_2}}</li></ol>
                      <a class="text-link" href="#stage-1">Link to stage 1 <span aria-hidden="true">↗</span></a>
                    </div>
                  </details>
                </li>
              </ol>
            </div>
          </div>
        </div>
        <dialog class="stage-focus-dialog" id="stage-focus-dialog" aria-labelledby="stage-card-title" aria-describedby="opportunity-note"></dialog>
      </section>

      <figure class="wide-photo">
        <img src="assets/{{WIDE_IMAGE}}" alt="{{WIDE_ALT}}" width="{{WIDE_WIDTH}}" height="{{WIDE_HEIGHT}}" loading="lazy">
        <figcaption>{{WIDE_CAPTION}}</figcaption>
      </figure>
      <section class="section-space practical" id="good-to-know" aria-labelledby="practical-title">
        <div class="section-heading">
          <p class="kicker">04 / Before you set off</p>
          <h2 id="practical-title">Good <em>to know.</em></h2>
          <p>A few practical details to make planning easier.</p>
        </div>
        <div class="advice-grid">
          <article><h3>Underfoot</h3><p>{{TERRAIN_ADVICE}}</p></article>
          <article><h3>What to bring</h3><p>{{KIT_ADVICE}}</p></article>
          <article><h3>Weather</h3><p>{{WEATHER_ADVICE}}</p></article>
          <article><h3>{{ACCESS_HEADING}}</h3><p>{{ACCESS_ADVICE}}</p></article>
        </div>
      </section>
      <section class="return-section section-space" id="return" aria-labelledby="return-title">
        <div>
          <p class="kicker">05 / The way home</p>
          <h2 id="return-title">{{RETURN_HEADING}}</h2>
          <p>{{RETURN_INTRO}}</p>
        </div>
        <div class="return-panel">
          <h3>Plan the return</h3>
          <p>{{RETURN_OPTIONS}}</p>
          <p class="small">{{RETURN_DETAILS}}</p>
          <a class="text-link" href="{{RETURN_SOURCE_URL}}">{{RETURN_SOURCE_LABEL}}</a>
        </div>
      </section>
      <div class="guide-sources">
        <p>Guide updated <time datetime="{{REVIEW_DATE_ISO}}">{{REVIEW_DATE}}</time> · distances from the supplied GPX.</p>
        <p><a href="{{ROUTE_SOURCE_URL}}">{{ROUTE_SOURCE_LABEL}}</a></p>
      </div>
      <a class="text-link back-link" href="/#field-guide"><span aria-hidden="true">←</span> Back to the Field Guide</a>
    </div>
  </main>
  <footer class="footer">
    <div class="wrap">
      <div class="footer-grid">
        <div><a class="brand" href="/#top"><img class="brand-logo" src="assets/sea-rocket-logo-white.png" alt="Sea Rocket"></a><p>Independent stays on the Yorkshire coast.<br>Made with care by Gary &amp; Sarah.</p></div>
        <div class="footer-links"><a href="/#house">The house</a><a href="/#explore">Explore</a><a href="/#book">Book direct</a><a href="stay.html">Guest guide</a><a href="https://www.airbnb.co.uk/rooms/1337580125558757353" target="_blank" rel="noopener">Airbnb reviews ↗</a></div>
      </div>
      <div class="footnote"><span>© <span id="year">2026</span> Sea Rocket Whitby</span><span>A proper place to get away.</span></div>
    </div>
  </footer>
  <script src="assets/site-chrome.js" defer></script>
  <script src="assets/walks/{{SLUG}}/route-data.js" defer></script>
  <script src="assets/walking-map.js" defer></script>
  <script src="assets/walking-stages.js" defer></script>
  <script src="assets/walking-decision.js" defer></script>
</body>
</html>
